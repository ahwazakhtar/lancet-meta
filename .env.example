# ---- Google Sheets ---------------------------------------------------------
# Local: point at the service-account JSON file.
GOOGLE_SERVICE_ACCOUNT_FILE=.credentials/google-service-account.json
# Railway: paste the entire JSON content here instead.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

GOOGLE_SHEET_ID=
PAPERS_SHEET_NAME=papers
EFFECT_SIZES_SHEET_NAME=effect_sizes

# ---- Web app ---------------------------------------------------------------
WEB_SECRET_KEY=change-me-to-a-long-random-string

# Local: file in repo. Railway: file under the mounted volume, e.g. /data/app.db
WEB_DB_PATH=data/app.db

# Local: bind on 127.0.0.1. Railway sets PORT automatically.
WEB_HOST=127.0.0.1
WEB_PORT=8000

# ---- Local extraction pipeline (not used by the deployed web app) ----------
PDF_DIR=pdfs
PREPROCESSED_DIR=data/preprocessed
EXTRACTED_DIR=data/extracted
PAPER_LIST_XLSX=base-data/field and paper list.xlsx
