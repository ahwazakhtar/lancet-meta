# Path to Google service account JSON. Share the target Google Sheet with this
# service account's email so it can write.
GOOGLE_SERVICE_ACCOUNT_FILE=.credentials/google-service-account.json

# Google Sheet ID (the long string in the sheet URL between /d/ and /edit).
GOOGLE_SHEET_ID=

# Tab names inside the spreadsheet
PAPERS_SHEET_NAME=papers
EFFECT_SIZES_SHEET_NAME=effect_sizes

# Web app
WEB_SECRET_KEY=change-me-to-a-long-random-string
WEB_DB_PATH=data/app.db
WEB_HOST=127.0.0.1
WEB_PORT=8000

# Extraction pipeline
PDF_DIR=pdfs
EXTRACTED_DIR=data/extracted
PAPER_LIST_XLSX=base-data/field and paper list.xlsx
